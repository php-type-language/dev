---
/*
 * Data flow between the packages of the toolkit.
 */
---

<figure class="pipeline not-content">
    <svg viewBox="0 0 900 300" role="img" aria-label="Data flow between the packages of the toolkit">
        <defs>
            <marker id="pipeline-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                <path d="M0,0 L10,5 L0,10 z" fill="currentColor" />
            </marker>
        </defs>
        <g fill="none" stroke="currentColor" stroke-width="1.25" marker-end="url(#pipeline-arrow)">
            <path d="M150,70 H240" />
            <path d="M150,150 H240" />
            <path d="M150,230 H240" />
            <path d="M350,70 H420 Q450,70 450,100 V125" />
            <path d="M350,150 H395" />
            <path d="M350,230 H400 Q450,230 450,200 V175" />
            <path d="M505,150 H590" />
            <path d="M700,150 H770" />
        </g>
        <g class="inputs">
            <rect x="30" y="50" width="120" height="40" /><text x="90" y="70">Reflection</text>
            <rect x="30" y="130" width="120" height="40" /><text x="90" y="150">"array&lt;K, V&gt;"</text>
            <rect x="30" y="210" width="120" height="40" /><text x="90" y="230">/** @param */</text>
        </g>
        <g>
            <rect x="240" y="50" width="110" height="40" /><text x="295" y="70">reader</text>
            <rect x="240" y="130" width="110" height="40" /><text x="295" y="150">parser</text>
            <rect x="240" y="210" width="110" height="40" /><text x="295" y="230">phpdoc</text>
            <rect class="core" x="395" y="125" width="110" height="50" /><text class="core-text" x="450" y="143">types</text><text class="core-text tiny" x="450" y="160">TypeLang\Type\*</text>
            <rect x="590" y="130" width="110" height="40" /><text x="645" y="150">printer</text>
        </g>
        <g class="inputs">
            <rect x="770" y="130" width="100" height="40" /><text x="820" y="150">"array"</text>
        </g>
    </svg>
    <figcaption><slot /></figcaption>
</figure>

<style>
    .pipeline {
        margin: 1.5rem 0;
        overflow-x: auto;
    }
    svg {
        width: 100%;
        min-width: 640px;
        height: auto;
        display: block;
        color: var(--ink);
        font-family: var(--mono);
        font-size: 14px;
    }
    rect {
        fill: var(--paper);
        stroke: var(--ink);
        stroke-width: 1.25;
    }
    .inputs rect {
        stroke: var(--line-2);
        stroke-dasharray: 3 3;
    }
    .inputs text {
        fill: var(--muted);
    }
    text {
        text-anchor: middle;
        fill: var(--ink);
        dominant-baseline: central;
    }
    .core {
        fill: var(--ink);
    }
    .core-text {
        fill: var(--paper);
    }
    .tiny {
        font-size: 10px;
    }
    figcaption {
        margin-top: 10px;
        font-size: 14px;
        color: var(--muted);
    }
</style>
