<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         backupGlobals="true"
         stopOnFailure="false"
         processIsolation="false"
         bootstrap="vendor/autoload.php"
         cacheDirectory="vendor/.cache.phpunit"
         backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="libs/mapper">
            <directory>libs/mapper/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/coercer">
            <directory>libs/mapper/libs/coercer/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/diagnostics">
            <directory>libs/mapper/libs/diagnostics/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/instantiator">
            <directory>libs/mapper/libs/instantiator/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/mapping">
            <directory>libs/mapper/libs/mapping/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/naming">
            <directory>libs/mapper/libs/naming/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/property-accessor">
            <directory>libs/mapper/libs/property-accessor/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/type-matcher">
            <directory>libs/mapper/libs/type-matcher/tests</directory>
        </testsuite>
        <testsuite name="libs/parser">
            <directory>libs/parser/tests</directory>
        </testsuite>
        <testsuite name="libs/phpdoc">
            <directory>libs/phpdoc/tests</directory>
        </testsuite>
        <testsuite name="libs/printer">
            <directory>libs/printer/tests</directory>
        </testsuite>
        <testsuite name="libs/reader">
            <directory>libs/reader/tests</directory>
        </testsuite>
        <testsuite name="libs/types">
            <directory>libs/types/tests</directory>
        </testsuite>
    </testsuites>

    <coverage/>

    <source>
        <include>
            <directory>libs/mapper/src</directory>
            <directory>libs/mapper/libs/coercer/src</directory>
            <directory>libs/mapper/libs/diagnostics/src</directory>
            <directory>libs/mapper/libs/instantiator/src</directory>
            <directory>libs/mapper/libs/mapping/src</directory>
            <directory>libs/mapper/libs/naming/src</directory>
            <directory>libs/mapper/libs/property-accessor/src</directory>
            <directory>libs/mapper/libs/type-matcher/src</directory>
            <directory>libs/parser/src</directory>
            <directory>libs/phpdoc/src</directory>
            <directory>libs/printer/src</directory>
            <directory>libs/reader/src</directory>
            <directory>libs/types/src</directory>
        </include>
    </source>

    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="-1"/>
    </php>
</phpunit>
