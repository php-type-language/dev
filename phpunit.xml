<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         backupGlobals="true"
         stopOnFailure="false"
         processIsolation="false"
         bootstrap="vendor/autoload.php"
         cacheDirectory="vendor/.cache.phpunit"
         backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="libs/mapper">
            <directory>libs/mapper/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/bridge/phpstan">
            <directory>libs/mapper/libs/bridge/phpstan/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/coercer">
            <directory>libs/mapper/libs/component/coercer/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/diagnostics">
            <directory>libs/mapper/libs/component/diagnostics/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/instantiator">
            <directory>libs/mapper/libs/component/instantiator/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/mapping">
            <directory>libs/mapper/libs/component/mapping/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/naming">
            <directory>libs/mapper/libs/component/naming/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/property-accessor">
            <directory>libs/mapper/libs/component/property-accessor/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper/type-matcher">
            <directory>libs/mapper/libs/component/type-matcher/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper-laravel">
            <directory>libs/mapper-laravel/tests</directory>
        </testsuite>
        <testsuite name="libs/mapper-symfony">
            <directory>libs/mapper-symfony/tests</directory>
        </testsuite>
        <testsuite name="libs/parser">
            <directory>libs/parser/tests</directory>
        </testsuite>
        <testsuite name="libs/phpdoc">
            <directory>libs/phpdoc/tests</directory>
        </testsuite>
        <testsuite name="libs/printer">
            <directory>libs/printer/tests</directory>
        </testsuite>
        <testsuite name="libs/reader">
            <directory>libs/reader/tests</directory>
        </testsuite>
        <testsuite name="libs/types">
            <directory>libs/types/tests</directory>
        </testsuite>
    </testsuites>

    <coverage/>

    <source>
        <include>
            <directory>libs/mapper/src</directory>
            <directory>libs/mapper/libs/bridge/phpstan/src</directory>
            <directory>libs/mapper/libs/component/coercer/src</directory>
            <directory>libs/mapper/libs/component/diagnostics/src</directory>
            <directory>libs/mapper/libs/component/instantiator/src</directory>
            <directory>libs/mapper/libs/component/mapping/src</directory>
            <directory>libs/mapper/libs/component/naming/src</directory>
            <directory>libs/mapper/libs/component/property-accessor/src</directory>
            <directory>libs/mapper/libs/component/type-matcher/src</directory>
            <directory>libs/mapper-laravel/src</directory>
            <directory>libs/mapper-symfony/src</directory>
            <directory>libs/parser/src</directory>
            <directory>libs/phpdoc/src</directory>
            <directory>libs/printer/src</directory>
            <directory>libs/reader/src</directory>
            <directory>libs/types/src</directory>
        </include>
    </source>

    <php>
        <ini name="error_reporting" value="-1"/>
        <ini name="memory_limit" value="-1"/>
    </php>
</phpunit>
