{
    "name": "type-lang/dev",
    "description": "TypeLang Components Monorepo",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {"type": "path", "url": "libs/*"}
    ],
    "require": {
        "php": "^8.1",
        "type-lang/mapper": "^2.0",
        "type-lang/mapper-laravel": "^2.0",
        "type-lang/mapper-symfony": "^2.0",
        "type-lang/parser": "^2.0",
        "type-lang/phpdoc": "^2.0",
        "type-lang/printer": "^2.0",
        "type-lang/reader": "^2.0",
        "type-lang/types": "^2.0"
    },
    "require-dev": {
        "cuyz/valinor": "^2.0",
        "doctrine/instantiator": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.95",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/config": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/container": "^10.0|^11.0|^12.0|^13.0",
        "jetbrains/phpstorm-attributes": "^1.3",
        "jms/serializer": "^3.32",
        "laravel/telescope": "^5.0",
        "nette/neon": "^3.4",
        "nikic/php-parser": "^5.9",
        "php-debugbar/php-debugbar": "^2.0|^3.0",
        "phpbench/phpbench": "^1.4",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phplrt/compiler": "^4.2.3",
        "phpstan/phpdoc-parser": "^2.4",
        "phpstan/phpstan": "^2.3.6",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0|^13.0",
        "psr/cache": "^2.0|^3.0",
        "psr/simple-cache": "^2.0|^3.0",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/expression-language": "^6.4|^7.0|^8.0",
        "symfony/property-access": "^6.4|^7.0|^8.0",
        "symfony/property-info": "^6.4|^7.0|^8.0",
        "symfony/serializer": "^6.4|^7.0|^8.0",
        "symfony/stopwatch": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.3.3"
    },
    "autoload-dev": {
        "psr-4": {
            "TypeLang\\Bench\\": "bench",
            "TypeLang\\Mapper\\Tests\\": "libs/mapper/tests",
            "TypeLang\\Mapper\\Bridge\\PHPStan\\Tests\\": "libs/mapper/libs/bridge/phpstan/tests",
            "TypeLang\\Mapper\\Bridge\\Laravel\\Tests\\": "libs/mapper-laravel/tests",
            "TypeLang\\Mapper\\Bridge\\Symfony\\Tests\\": "libs/mapper-symfony/tests",
            "TypeLang\\Mapper\\Coercer\\Tests\\": "libs/mapper/libs/component/coercer/tests",
            "TypeLang\\Mapper\\Diagnostics\\Tests\\": "libs/mapper/libs/component/diagnostics/tests",
            "TypeLang\\Mapper\\Instantiator\\Tests\\": "libs/mapper/libs/component/instantiator/tests",
            "TypeLang\\Mapper\\Mapping\\Tests\\": "libs/mapper/libs/component/mapping/tests",
            "TypeLang\\Mapper\\Naming\\Tests\\": "libs/mapper/libs/component/naming/tests",
            "TypeLang\\Mapper\\PropertyAccessor\\Tests\\": "libs/mapper/libs/component/property-accessor/tests",
            "TypeLang\\Mapper\\TypeMatcher\\Tests\\": "libs/mapper/libs/component/type-matcher/tests",
            "TypeLang\\Parser\\Tests\\": "libs/parser/tests",
            "TypeLang\\Printer\\Tests\\": "libs/printer/tests",
            "TypeLang\\PhpDoc\\Build\\": "libs/phpdoc/build",
            "TypeLang\\PhpDoc\\Tests\\": "libs/phpdoc/tests",
            "TypeLang\\Reader\\Tests\\": "libs/reader/tests",
            "TypeLang\\Type\\Tests\\": "libs/types/tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev",
            "dev-main": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": true,
        "bin-compat": "full",
        "preferred-install": {
            "*": "dist"
        }
    },
    "scripts-aliases": {
        "test:unit": ["test", "phpunit", "unit"],
        "linter:check": ["linter", "stan"],
        "phpcs:check": ["phpcs", "cs", "psr", "per"]
    },
    "scripts": {
        "bench": "phpbench run ./bench --report=compare",
        "test:unit": "phpunit",
        "linter:check": "phpstan analyse --configuration phpstan.neon --memory-limit 256M",
        "linter:baseline": "@linter:check --generate-baseline",
        "phpcs:check": "@phpcs:fix --dry-run",
        "phpcs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --verbose --diff"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
