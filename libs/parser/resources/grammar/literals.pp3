/**
 * -----------------------------------------------------------------------------
 *  Literals
 * -----------------------------------------------------------------------------
 */


// Any of the literals below. Requires the `literals` feature
Literal -> {
    /** @var Type\Literal\LiteralNode $children */
    if (!$this->features->literals) {
        throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabled(
            feature: 'literals',
            text: $children->raw,
            offset: $offset,
            source: $source,
        );
    }

    return $children;
}
  : NullLiteral()
  | BoolLiteral()
  | FloatLiteral()
  | IntLiteral()
  | StringLiteral()
  ;

BoolLiteral
  : TrueLiteral()
  | FalseLiteral()
  ;

FalseLiteral -> {
    return new Type\Literal\BoolLiteralNode(false, $children->value, $offset);
}
  : <T_FALSE>
  ;

TrueLiteral -> {
    return new Type\Literal\BoolLiteralNode(true, $children->value, $offset);
}
  : <T_TRUE>
  ;

NullLiteral -> {
    return new Type\Literal\NullLiteralNode($children->value, $offset);
}
  : <T_NULL>
  ;

// 42, 0x1F, 0b101, 0o17, 017, -42, 1_000
IntLiteral
  : DecIntLiteral()
  | HexIntLiteral()
  | BinIntLiteral()
  | OctIntLiteral()
  | OctLegacyIntLiteral()
  ;

// 42, -42, 1_000
DecIntLiteral -> {
    return $this->decInt->parse($children->value, $offset);
}
  : <T_INT_DEC>
  ;

// 0x1F, -0XDE_AD
HexIntLiteral -> {
    return $this->hexInt->parse($children->value, $offset);
}
  : <T_INT_HEX>
  ;

// 0b101, 0B10_10
BinIntLiteral -> {
    return $this->binInt->parse($children->value, $offset);
}
  : <T_INT_BIN>
  ;

// 0o17, 0O6_5_5
OctIntLiteral -> {
    return $this->octInt->parse($children->value, $offset);
}
  : <T_INT_OCT>
  ;

// 017, 0_42, 0
OctLegacyIntLiteral -> {
    return $this->octLegacyInt->parse($children->value, $offset);
}
  : <T_INT_OCT_LEGACY>
  ;

// 1.5, .5, 1e-3
FloatLiteral -> {
    return $this->float->parse($children->value, $offset);
}
  : <T_FLOAT>
  ;


// 'text', "text"
StringLiteral
  : SingleQuotedStringLiteral()
  | DoubleQuotedStringLiteral()
  ;

DoubleQuotedStringLiteral -> {
    return $this->dqString->parse($children->value, $offset);
}
  : <T_DQ_STRING>
  ;

SingleQuotedStringLiteral -> {
    return $this->sqString->parse($children->value, $offset);
}
  : <T_SQ_STRING>
  ;
