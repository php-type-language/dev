
%include shapes/fields

/**
 * -----------------------------------------------------------------------------
 *  Shapes
 *
 *  A shape is a part of a named type: "array{...}", "list{...}", "Some{...}".
 * -----------------------------------------------------------------------------
 */

// {a: int}, {a: int, ...}, {...<K, V>}. Returns the list of the fields and the
// arguments of the unsealed part, null if there are none
ShapeFields -> {
    if (!$this->features->shapes) {
        throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabledIn('shapes', $ctx);
    }

    $fields = new Type\Shape\FieldListNode([], true, $offset);
    $arguments = null;

    foreach ($children as $child) {
        switch (true) {
            case $child instanceof Type\Shape\FieldNode:
                $fields->items[] = $child;
                break;

            case $child instanceof Type\Template\TemplateListNode:
                $arguments = $child;
                break;

            default:
                $fields->isSealed = false;
                break;
        }
    }

    return [$fields, $arguments];
}
  : ::T_BRACE_OPEN::
        (ShapeFieldList() ShapeTail()? | ShapeUnsealed())?
    ::T_BRACE_CLOSE::
  ;

// a: int, b?: string, int
ShapeFieldList
  : ShapeField()
    (::T_COMMA:: ShapeField())*
  ;

// A trailing comma, with the unsealed part behind it or without it
ShapeTail
  : ::T_COMMA:: ShapeUnsealed()?
  ;

// ..., ...<K, V>, ..., . The ellipsis is kept, it tells the shape is not sealed
ShapeUnsealed
  : <T_ELLIPSIS> TemplateArguments()? ::T_COMMA::?
  ;
