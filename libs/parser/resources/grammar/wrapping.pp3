/**
 * -----------------------------------------------------------------------------
 *  Wrapping Types
 *
 *  The types that wrap another one: the nullable, the lists and the offset
 *  accesses. A level of precedence is a rule of its own, from the weakest to the
 *  strongest: Nullable, ListOrOffsetAccess. Both are tighter than the logical
 *  types, see logical.pp3.
 * -----------------------------------------------------------------------------
 */


// A type with the "?" before it or without it. The question mark is weaker than
// the suffixes and stronger than the operators: ?A[] is ?(A[]), ?A|B is (?A)|B,
// ?A&B is (?A)&B
NullableType
  : QuestionType()
  | ListTypeOrOffsetAccess()
  ;

// ?int, ?int[], ?Foo<T>
QuestionType -> {
    if (!$this->features->nullables) {
        throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabledIn('nullables', $ctx);
    }

    return new Type\WrappingTypeNode\NullableTypeNode($children[1], $offset);
}
  : <T_QUESTION> ListTypeOrOffsetAccess()
  ;


// A type with the "[]" and "[K]" suffixes behind it: int, int[], T[K],
// Foo::BAR[][], (A)[], T['a'][]
ListTypeOrOffsetAccess -> {
    // No suffixes
    if (!\is_array($children)) {
        return $children;
    }

    // The children are the type and the suffixes: the closing bracket for
    // "[]" and the type inside of the brackets for "[K]"
    $type = null;

    foreach ($children as $child) {
        switch (true) {
            case $type === null:
                $type = $child;
                break;

            case $child instanceof Type\TypeNode:
                $type = new Type\WrappingTypeNode\TypeOffsetAccessTypeNode($type, $child, $offset);
                break;

            default:
                $type = new Type\WrappingTypeNode\TypesListTypeNode($type, $offset);
                break;
        }
    }

    return $type;
}
  : Atom() (ListSuffix() | OffsetSuffix())*
  ;

// []
ListSuffix -> {
    if (!$this->features->lists) {
        throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabledIn('lists', $ctx);
    }

    return $children[1];
}
  : <T_BRACKET_OPEN> <T_BRACKET_CLOSE>
  ;

// [K], [42], ['a']
OffsetSuffix -> {
    if (!$this->features->offsets) {
        throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabledIn('offsets', $ctx);
    }

    return $children[1];
}
  : <T_BRACKET_OPEN> Type() <T_BRACKET_CLOSE>
  ;
