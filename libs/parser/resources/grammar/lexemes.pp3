
/**
 * -----------------------------------------------------------------------------
 *  Pattern Fragments
 * -----------------------------------------------------------------------------
 *
 *  The pieces the token definitions below are spelled out of. A fragment
 *  recognizes nothing on its own and reaches no token stream.
 *
 */

%fragment IDENT_HEAD    [a-zA-Z_\x80-\xff]
%fragment IDENT_TAIL    [a-zA-Z0-9\-_\x80-\xff]
%fragment DIGIT         [0-9]
%fragment EXPONENT      [eE]-?(?&DIGIT)++

// A keyword ends where an identifier would go on, so that "isEmpty" is a name
// rather than the "is" operator followed by one.
%fragment KEYWORD_END   (?!(?&IDENT_TAIL))

/**
 * -----------------------------------------------------------------------------
 *  Lexeme/Token Definitions
 * -----------------------------------------------------------------------------
 *
 *  The lexer takes the first pattern that matches, so the order below is both
 *  a matter of meaning (a longer token above the shorter one it starts with)
 *  and a matter of speed (a token that occurs more often above one that does
 *  not).
 *
 */

// Whitespace is the most frequent thing there is in a type statement
%skip   T_WHITESPACE            \s++

// Keywords, above the identifier they would otherwise be read as
%token  T_NEQ                   (?i:is\h++not)(?&KEYWORD_END)
%token  T_EQ                    (?i:is)(?&KEYWORD_END)
%token  T_BOOL_LITERAL          (?i:true|false)(?&KEYWORD_END)
%token  T_NULL_LITERAL          (?i:null)(?&KEYWORD_END)

// Identifiers
%token  T_NAME_WITH_SPACE       (?&IDENT_HEAD)(?&IDENT_TAIL)*+\s++
%token  T_NAME                  (?&IDENT_HEAD)(?&IDENT_TAIL)*+

// Punctuation, ordered by how often a type statement contains it
%token  T_NS_DELIMITER          \\
%token  T_OR                    \|
%token  T_COMMA                 ,
%token  T_DOUBLE_COLON          ::
%token  T_COLON                 :
%token  T_LTE                   <=
%token  T_GTE                   >=
%token  T_ANGLE_BRACKET_OPEN    <
%token  T_ANGLE_BRACKET_CLOSE   >
%token  T_QMARK                 \?
%token  T_BRACE_OPEN            \{
%token  T_BRACE_CLOSE           \}
%token  T_PARENTHESIS_OPEN      \(
%token  T_PARENTHESIS_CLOSE     \)
%token  T_SQUARE_BRACKET_OPEN   \[
%token  T_SQUARE_BRACKET_CLOSE  \]
%token  T_AMP                   &
%token  T_ELLIPSIS              \.\.\.
%token  T_ASSIGN                =
%token  T_ASTERISK              \*

// Variables
%token  T_THIS                  \$this\b
%token  T_VARIABLE              \$(?&IDENT_HEAD)(?&IDENT_TAIL)*+

// Literals
%token  T_DQ_STRING_LITERAL     "[^"\\]*+(?:\\.[^"\\]*+)*+"
%token  T_SQ_STRING_LITERAL     '[^'\\]*+(?:\\.[^'\\]*+)*+'
%token  T_PFX_FLOAT_LITERAL     -?(?&DIGIT)++\.(?&DIGIT)*+(?:(?&EXPONENT))?
%token  T_SFX_FLOAT_LITERAL     -?(?&DIGIT)*+\.(?&DIGIT)++(?:(?&EXPONENT))?
%token  T_EXP_LITERAL           -?(?&DIGIT)++(?&EXPONENT)
%token  T_BIN_INT_LITERAL       -?0[bB][01_]++
%token  T_OCT_INT_LITERAL       -?0[oO][0-7_]++
%token  T_HEX_INT_LITERAL       -?0[xX][0-9a-fA-F_]++
%token  T_DEC_INT_LITERAL       -?(?&DIGIT)[0-9_]*+

// Comments
%skip   T_COMMENT               (?://|#)[^\r\n]*+
%skip   T_DOC_COMMENT           /\*.*?\*/
