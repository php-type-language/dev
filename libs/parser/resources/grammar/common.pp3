
// "Some\Any" or "\Some\Any"
Name
  : FullQualifiedName()
  | RelativeName()
  ;

// "\Some\Any"
FullQualifiedName -> {
    return new Type\Name($children, true, $offset);
}
  : ::T_NS_DELIMITER:: Identifier() @error("Syntax error, unexpected {token}, a name must carry a segment after the separator, for example \"\Some\"")
    NameTail()*
  ;

// "Some\Any"
RelativeName -> {
    return new Type\Name($children, false, $offset);
}
  : Identifier() NameTail()*
  ;

NameTail
  : ::T_NS_DELIMITER:: Identifier() @error("Syntax error, unexpected {token}, a name must carry a segment after the separator, for example \"Some\Any\"")
  ;

Identifier -> {
    return new Type\Identifier(
        $children->id === self::T_NAME_WITH_SPACE
            ? \rtrim($children->value)
            : $children->value,
        $offset,
    );
}
  : <T_NAME>
  | <T_NAME_WITH_SPACE>
  | <T_EQ>
  | <T_NOT>
  | <T_TRUE_LITERAL>
  | <T_FALSE_LITERAL>
  | <T_NULL_LITERAL>
  ;

IdentifierWithExtraSpace -> {
    return new Type\Identifier(\rtrim($children->value), $offset);
}
    : <T_NAME_WITH_SPACE>
    ;

// Any "$variable" (including "$this")
Variable -> {
    return new Type\VariableNode(
        new Type\Identifier(\substr($children->value, 1), $offset),
        $offset,
    );
}
  : <T_VARIABLE>
  | <T_THIS>
  ;

// The "$this" of a "callable(): $this"
ThisType -> {
    return new Type\ThisNode($offset);
}
  : <T_THIS>
  ;

// "*" in "T<*>" or "JSON_*"
WildcardType -> {
    return new Type\WildcardNode($offset);
}
  : <T_ASTERISK>
  ;
