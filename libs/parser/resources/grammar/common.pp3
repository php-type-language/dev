
Name
  : FullQualifiedName()
  | RelativeName()
  ;

FullQualifiedName -> {
    return new Type\Name($children, true, $offset);
}
  : ::T_NS_DELIMITER:: Identifier() (::T_NS_DELIMITER:: Identifier())*
  ;

RelativeName -> {
    return new Type\Name($children, false, $offset);
}
  : Identifier() (::T_NS_DELIMITER:: Identifier())*
  ;

Identifier -> {
    // Only a name written with a trailing space carries one, so the value of
    // every other token is the identifier itself
    return new Type\Identifier(
        $children->id === self::T_NAME_WITH_SPACE
            ? \rtrim($children->value)
            : $children->value,
        $offset,
    );
}
  : <T_NAME>
  | <T_NAME_WITH_SPACE>
  | <T_EQ>
  | <T_BOOL_LITERAL>
  | <T_NULL_LITERAL>
  ;

IdentifierWithExtraSpace -> {
    return new Type\Identifier(\rtrim($children->value), $offset);
}
    : <T_NAME_WITH_SPACE>
    ;
