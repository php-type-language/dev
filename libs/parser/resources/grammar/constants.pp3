/**
 * -----------------------------------------------------------------------------
 *  Constants
 *
 *  The part of a constant of a class that follows the colons, a lone word or
 *  a mask. A mask is one token, the stars of it are cut out of the text.
 * -----------------------------------------------------------------------------
 */


// BAR_*, *_BAZ, A*B*C
IdentifierMask -> {
    $items = [];
    $position = $offset;

    foreach (\explode('*', $children->value) as $index => $word) {
        if ($index > 0) {
            $items[] = new Type\Constant\MaskNode\WildcardMaskNode($position++);
        }

        if ($word !== '') {
            $items[] = new Type\Identifier($word, $position);
            $position += \strlen($word);
        }
    }

    return new Type\Constant\MaskNode($items, $offset);
}
  : <T_IDENTIFIER_MASK>
  ;

// *
WildcardMask -> {
    return new Type\Constant\MaskNode([new Type\Constant\MaskNode\WildcardMaskNode($offset)], $offset);
}
  : <T_WILDCARD>
  ;

// BAR, BAR_*, *, *_BAZ, A*B*C
ConstantMask
  : IdentifierMask()
  | WildcardMask()
  | Identifier()
  ;


// PHP_*, *_SUFFIX, \PHP_*, Foo\BAR_*, Path\To\*, \*. A lone star is a mask
// only behind a namespace
ConstMaskType -> {
    // PHP_*
    if (!\is_array($children)) {
        return new Type\Constant\ConstMaskTypeNode($children, null, $offset);
    }

    // Foo\BAR_*, \*
    return new Type\Constant\ConstMaskTypeNode($children[1], $children[0], $offset);
}
  : IdentifierMask()
  | Namespace() (IdentifierMask() | WildcardMask())
  ;
