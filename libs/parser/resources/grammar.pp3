
/**
 * -----------------------------------------------------------------------------
 *  Language Syntax Summary
 * -----------------------------------------------------------------------------
 */

%include grammar/lexemes                // Lexeme/Token Definitions
%include grammar/common                 // Common Utils
%include grammar/literals               // Literal Definitions
%include grammar/template-arguments     // T<TArg, TArg2>
%include grammar/callable               // callable(mixed): void
%include grammar/shape-fields           // array { key: int, ...<TKey, TValue> }
%include grammar/named-type             // Map<int<0, max>, non-empty-string>
%include grammar/ternary                // T is A ? B : C

%pragma root Type

/**
 * -----------------------------------------------------------------------------
 *  Type Statement
 * -----------------------------------------------------------------------------
 *
 *  Constant references to external definitions or
 *  describe the type in some way.
 *
 */

Type -> {
    if (\count($children) === 1) {
        return $children[0];
    }

    if ($this->features->conditions === false) {
        throw Exception\FeatureNotAllowedException::becauseFeatureIsNotAllowed('conditional expressions', $offset);
    }

    $condition = match ($children[1]->id) {
        self::T_EQ => new Type\Condition\EqualConditionNode(
            $children[0],
            $children[2],
            $offset,
        ),
        self::T_NEQ => new Type\Condition\NotEqualConditionNode(
            $children[0],
            $children[2],
            $offset,
        ),
        self::T_GTE => new Type\Condition\GreaterThanOrEqualConditionNode(
            $children[0],
            $children[2],
            $offset,
        ),
        self::T_ANGLE_BRACKET_CLOSE => new Type\Condition\GreaterThanConditionNode(
            $children[0],
            $children[2],
            $offset,
        ),
        self::T_LTE => new Type\Condition\LessThanOrEqualConditionNode(
            $children[0],
            $children[2],
            $offset,
        ),
        self::T_ANGLE_BRACKET_OPEN => new Type\Condition\LessThanConditionNode(
            $children[0],
            $children[2],
            $offset,
        ),
        default => throw Exception\InvalidConditionalOperatorException::becauseConditionalOperatorIsInvalid(
            $children[1]->value,
            $offset,
        ),
    };

    return new Type\TernaryExpressionNode(
        $condition,
        $children[3],
        $children[4],
        $offset,
    );
}
  : LogicalType() TernaryExpressionSuffix()?
  | VariableLiteral() TernaryExpressionSuffix()
  ;

/**
 * -----------------------------------------------------------------------------
 *  Logical Statements
 * -----------------------------------------------------------------------------
 *
 *  Logical statements denote union or intersection types, like:
 *  - A | B | C - for union type references.
 *  - A & B & C - for intersection type references.
 *
 *  A repetition rather than a right recursion: every member of a statement is
 *  collected in a single list, so the node is built once instead of being
 *  rebuilt (and re-flattened) at each of its levels.
 *
 */

LogicalType
  : UnionType()
  ;

UnionType -> {
    if (\count($children) === 1) {
        return $children[0];
    }

    if ($this->features->unions === false) {
        throw Exception\FeatureNotAllowedException::becauseFeatureIsNotAllowed('union types', $offset);
    }

    // A logical statement takes an arbitrary number of types, so its
    // offset is assigned rather than passed to the constructor
    $statement = new Type\UnionTypeNode($children);
    $statement->offset = $offset;

    return $statement;
}
  : IntersectionType() (::T_OR:: IntersectionType())*
  ;

IntersectionType -> {
    if (\count($children) === 1) {
        return $children[0];
    }

    if ($this->features->intersections === false) {
        throw Exception\FeatureNotAllowedException::becauseFeatureIsNotAllowed('intersection types', $offset);
    }

    // A logical statement takes an arbitrary number of types, so its
    // offset is assigned rather than passed to the constructor
    $statement = new Type\IntersectionTypeNode($children);
    $statement->offset = $offset;

    return $statement;
}
  : UnaryType() (::T_AMP:: UnaryType())*
  ;

/**
 * -----------------------------------------------------------------------------
 *  Unary Statements
 * -----------------------------------------------------------------------------
 *
 *  Unary statements denote terminal types, like:
 *  - A - for type reference.
 *  - ?A - for nullable type reference.
 *  - 'some' - for string literal reference.
 *  - etc...
 *
 */

UnaryType
  : NullableType()
  | TypesList()
  ;

// stmt = ?Type
NullableType -> {
    return new Type\NullableTypeNode($children[0], $offset);
}
  : ::T_QMARK:: TypesList()
  ;

TypesList -> {
    $statement = $children[0];
    $count = \count($children);

    for ($i = 1; $i < $count; ++$i) {
        $child = $children[$i];

        switch (true) {
            // In case of list type
            case $child === true:
                if ($this->features->lists === false) {
                    throw Exception\FeatureNotAllowedException::becauseFeatureIsNotAllowed('square bracket list types', $offset);
                }

                $statement = new Type\TypesListNode($statement, $offset);
                break;
            // In case of offset access type
            case $child instanceof Type\TypeNode:
                if ($this->features->offsets === false) {
                    throw Exception\FeatureNotAllowedException::becauseFeatureIsNotAllowed('type offsets', $offset);
                }

                $statement = new Type\TypeOffsetAccessNode($statement, $child, $offset);
                break;
            default:
                throw Exception\InternalSemanticException::becauseSubNodeIsUnexpected(
                    \get_debug_type($child),
                    $offset,
                );
        }
    }

    return $statement;
}
  : PrimaryType()
    TypeListOrOffsetSuffix()*
  ;

// - Returns `true` in case of a list type (`T[]`).
// - Returns `TypeNode` in case of an offset access type (`T[Y]`).
TypeListOrOffsetSuffix -> {
    return $children[0] ?? true;
}
  : ::T_SQUARE_BRACKET_OPEN::
      Type()?
    ::T_SQUARE_BRACKET_CLOSE::
  ;

PrimaryType
  : ::T_PARENTHESIS_OPEN:: Type() ::T_PARENTHESIS_CLOSE::
  | ThisLiteral()
  | Literal()
  | NamedType()
  ;
