/**
 * -----------------------------------------------------------------------------
 *  Language Syntax Summary
 *
 *  A rule is named after the node of the syntax tree it stands for, and reads
 *  its own sequence of tokens.
 * -----------------------------------------------------------------------------
 */


%include grammar/lexemes
%include grammar/names
%include grammar/literals
%include grammar/constants
%include grammar/templates
%include grammar/callable
%include grammar/shapes
%include grammar/logical
%include grammar/wrapping
%include grammar/conditions

%pragma lexer.pcre.disable u
%pragma root Type


/**
 * -----------------------------------------------------------------------------
 *  Type Statement
 * -----------------------------------------------------------------------------
 */


// Any type, the weakest level of precedence. An entry point
#Type -> {
    if (\is_array($children)) {
        return $children[0];
    }

    return $children;
}
  : NullableType()
  ;


/**
 * -----------------------------------------------------------------------------
 *  Nullable Types
 * -----------------------------------------------------------------------------
 */


// A type with the "?" before it: int, ?int, ?int[], ?T[K]. The question mark is
// weaker than the suffixes, so it reaches over all of them: ?int[] is ?(int[])
NullableType -> {
    if (!\is_array($children)) {
        return $children;
    }

    // [type], there is no question mark
    if (!isset($children[1])) {
        return $children[0];
    }

    // [question mark, type]
    if (!$this->features->nullables) {
        throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabled(
            'nullables',
            $ctx->source,
            $children[0]->offset,
            1,
        );
    }

    return new Type\WrappingTypeNode\NullableTypeNode($children[1], $children[0]->offset);
}
  : <T_QUESTION>? ListTypeOrOffsetAccess()
  ;


/**
 * -----------------------------------------------------------------------------
 *  Lists and Offset Accesses
 * -----------------------------------------------------------------------------
 */


// A type with the "[]" and "[K]" suffixes behind it: int, int[], T[K],
// Foo::BAR[][], (A)[], T['a'][]
ListTypeOrOffsetAccess -> {
    // No suffixes
    if (!\is_array($children)) {
        return $children;
    }

    // The children are the type and the opening brackets, a bracket is
    // followed by the type inside of it (the key), if there is one
    $type = $children[0];
    $bracket = null;
    $length = \count($children);

    // The element behind the last one is the end: it closes the last bracket
    for ($i = 1; $i <= $length; ++$i) {
        $child = $children[$i] ?? null;

        // T[K], the key belongs to the bracket before it
        if ($child instanceof Type\TypeNode) {
            if (!$this->features->offsets) {
                throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabled(
                    'offsets',
                    $ctx->source,
                    $bracket->offset,
                    1,
                );
            }

            $type = new Type\WrappingTypeNode\TypeOffsetAccessTypeNode($type, $child, $bracket->offset);
            $bracket = null;

            continue;
        }

        // T[], the previous bracket has nothing inside
        if ($bracket !== null) {
            if (!$this->features->lists) {
                throw Exception\FeatureNotEnabledException::becauseFeatureIsNotEnabled(
                    'lists',
                    $ctx->source,
                    $bracket->offset,
                    1,
                );
            }

            $type = new Type\WrappingTypeNode\TypesListTypeNode($type, $bracket->offset);
        }

        $bracket = $child;
    }

    return $type;
}
  : Atom() (<T_BRACKET_OPEN> Type()? ::T_BRACKET_CLOSE::)*
  ;

// A type that stands alone: the suffixes and the operators go behind it
Atom
  : Literal()
  | NamedType()
  | ThisType()
  | ConstMaskType()
  | Group()
  ;


/**
 * -----------------------------------------------------------------------------
 *  Named Types
 * -----------------------------------------------------------------------------
 */


// Foo, \Foo\Bar, Foo::BAR, Foo::BAR_*, Foo::*
NamedType -> {
    $name = $children[0];
    $constant = $children[1] ?? null;

    // Foo, \Foo\Bar
    if ($constant === null) {
        return new Type\NamedTypeNode($name, null, null, $offset);
    }

    // Foo::BAR, a lone word is a constant
    if ($constant instanceof Type\Identifier) {
        return new Type\Constant\ClassConstTypeNode($name, $constant, $offset);
    }

    // Foo::BAR_*, anything else is a mask of constants
    return new Type\Constant\ClassConstMaskTypeNode($name, $constant, $offset);
}
  : Name() (::T_DOUBLE_COLON:: ConstantMask())?
  ;

/**
 * -----------------------------------------------------------------------------
 *  This Type
 * -----------------------------------------------------------------------------
 */


// $this
ThisType -> {
    return new Type\ThisTypeNode($offset);
}
  : <T_THIS>
  ;


/**
 * -----------------------------------------------------------------------------
 *  Group
 * -----------------------------------------------------------------------------
 */


// (int), ((int)). The parentheses only group, they build no node
Group
  : ::T_PAREN_OPEN:: Type() ::T_PAREN_CLOSE::
  ;
