/**
 * -----------------------------------------------------------------------------
 *  Language Syntax Summary
 *
 *  A rule is named after the node of the syntax tree it stands for, and reads
 *  its own sequence of tokens.
 * -----------------------------------------------------------------------------
 */


%include grammar/lexemes
%include grammar/names
%include grammar/literals
%include grammar/constants
%include grammar/templates
%include grammar/callable
%include grammar/shapes
%include grammar/logical
%include grammar/wrapping
%include grammar/conditions

%pragma lexer.pcre.disable u
%pragma root Type


/**
 * -----------------------------------------------------------------------------
 *  Type Statement
 * -----------------------------------------------------------------------------
 */


// Any type, the weakest level of precedence. An entry point
#Type -> {
    if (\is_array($children)) {
        return $children[0];
    }

    return $children;
}
  : UnionType()
  ;


/**
 * -----------------------------------------------------------------------------
 *  Atoms
 * -----------------------------------------------------------------------------
 */


// A type that stands alone: the suffixes and the operators go behind it
Atom
  : Literal()
  | NamedType()
  | ThisType()
  | ConstMaskType()
  | Group()
  ;


/**
 * -----------------------------------------------------------------------------
 *  Named Types
 * -----------------------------------------------------------------------------
 */


// Foo, \Foo\Bar, Foo::BAR, Foo::BAR_*, Foo::*, Foo<T>, \Foo\Bar<T, U>, Foo{...}, \Foo\Bar{...},
// Foo(int): void
NamedType -> {
    $name = $children[0];
    $second = $children[1] ?? null;

    return match (true) {
        // Foo, \Foo\Bar
        $second === null => new Type\NamedTypeNode($name, null, null, $offset),
        // Foo<T>, \Foo\Bar<T, U>
        $second instanceof Type\Template\TemplateListNode => new Type\NamedTypeNode($name, $second, null, $offset),
        // Foo{...}, Foo{...<K, V>}
        $second instanceof Type\Shape\FieldListNode => new Type\NamedTypeNode($name, $children[2] ?? null, $second, $offset),
        // Foo(int): void, Foo()
        $second instanceof Type\Callable\CallableParameterListNode => new Type\Callable\CallableTypeNode($name, $second, $children[2] ?? null, null, $offset),
        // Foo::BAR, a lone word is a constant
        $second instanceof Type\Identifier => new Type\Constant\ClassConstTypeNode($name, $second, $offset),
        // Foo::BAR_*, anything else is a mask of constants
        default => new Type\Constant\ClassConstMaskTypeNode($name, $second, $offset),
    };
}
  : Name() (
      ::T_DOUBLE_COLON:: ConstantMask()
      | TemplateArguments()
      | ShapeFields()
      | CallableSignature()
    )?
  ;

/**
 * -----------------------------------------------------------------------------
 *  This Type
 * -----------------------------------------------------------------------------
 */


// $this
ThisType -> {
    return new Type\ThisTypeNode($offset);
}
  : <T_THIS>
  ;


/**
 * -----------------------------------------------------------------------------
 *  Variables
 *
 *  A variable is no type, it stands in the parameters of a callable and in the
 *  conditions, so it is a rule of its own with its own entry.
 * -----------------------------------------------------------------------------
 */


// $a, $_x, $thisFoo. The name of the node is the text behind the dollar sign
#Variable -> {
    return new Type\VariableNode(\substr($children->value, 1), $offset);
}
  : <T_VARIABLE>
  ;


/**
 * -----------------------------------------------------------------------------
 *  Group
 * -----------------------------------------------------------------------------
 */


// (int), ((int)). The parentheses only group, they build no node
Group
  : ::T_PAREN_OPEN:: Type() ::T_PAREN_CLOSE::
  ;
