{
    "name": "type-lang/mapper-symfony",
    "type": "symfony-bundle",
    "description": "Symfony integration of the TypeLang mapper",
    "keywords": ["types", "mapper", "serializer", "normalizer", "denormalizer", "symfony", "bundle"],
    "license": "MIT",
    "support": {
        "source": "https://github.com/php-type-language/mapper-symfony",
        "issues": "https://github.com/php-type-language/mapper-symfony/issues"
    },
    "require": {
        "php": "^8.1",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/var-dumper": "^6.4|^7.0|^8.0",
        "type-lang/mapper": "self.version",
        "type-lang/parser": "self.version",
        "type-lang/printer": "self.version",
        "type-lang/types": "self.version"
    },
    "autoload": {
        "psr-4": {
            "TypeLang\\Mapper\\Bridge\\Symfony\\": "src"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.6",
        "phpunit/phpunit": "^10.5.36|^11.0|^12.0|^13.0",
        "symfony/expression-language": "^6.4|^7.0|^8.0",
        "symfony/stopwatch": "^6.4|^7.0|^8.0",
        "symfony/yaml": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.3.3"
    },
    "suggest": {
        "symfony/stopwatch": "(^6.4|^7.0|^8.0) Allows showing the mapper calls on the timeline of the profiler"
    },
    "autoload-dev": {
        "psr-4": {
            "TypeLang\\Mapper\\Bridge\\Symfony\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev",
            "dev-main": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": true,
        "bin-compat": "full",
        "preferred-install": {
            "*": "dist"
        }
    },
    "scripts-aliases": {
        "test:unit": ["test", "phpunit", "unit"]
    },
    "scripts": {
        "test:unit": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
