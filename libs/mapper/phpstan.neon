includes:
  - libs/coercer/phpstan.neon
  - libs/diagnostics/phpstan.neon
  - libs/instantiator/phpstan.neon
  - libs/mapping/phpstan.neon
  - libs/naming/phpstan.neon
  - libs/property-accessor/phpstan.neon

parameters:
  level: max
  phpVersion:
    min: 80100
    max: 80599
  treatPhpDocTypesAsCertain: false
  fileExtensions:
    - php
  paths:
    - src
